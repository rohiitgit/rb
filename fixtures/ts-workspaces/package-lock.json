{
  "name": "ws-root",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ws-root",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@ws/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@ws/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/app": {
      "name": "@ws/app",
      "version": "1.0.0",
      "dependencies": {
        "@ws/core": "1.0.0"
      }
    },
    "packages/core": {
      "name": "@ws/core",
      "version": "1.0.0"
    }
  }
}
